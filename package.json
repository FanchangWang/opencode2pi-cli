{
  "name": "opencode2pi-cli",
  "version": "0.2.1",
  "description": "OpenCode Zen's free models, served through your local OpenCode CLI, as an in-process omp/pi provider extension.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FanchangWang/opencode2pi-cli.git"
  },
  "keywords": [
    "omp",
    "pi",
    "pi-extension",
    "opencode",
    "opencode-zen",
    "free-models",
    "pi-package"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "smoke": "omp -e ./src/index.ts -p --model opencode-zen-cli/oc-space-bunny-free \"Reply with exactly OK\""
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.6.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.0"
  }
}